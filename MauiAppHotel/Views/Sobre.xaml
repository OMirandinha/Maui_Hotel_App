<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#000000">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="20"
                         Spacing="20">

        <Frame BackgroundColor="#FF6B6B"
               CornerRadius="50"
               HeightRequest="100"
               WidthRequest="100"
               HorizontalOptions="Center"
               HasShadow="True">
            <Label Text="H"
                   FontSize="50"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontAttributes="Bold"/>
        </Frame>

        <Label Text="Hotel App"
               FontFamily="Kalam"
               FontSize="35"
               TextColor="#FF6B6B"
               HorizontalOptions="Center"
               FontAttributes="Bold"/>

        <Frame BackgroundColor="#000000"
               CornerRadius="15"
               Padding="15"
               HasShadow="True">
            <VerticalStackLayout Spacing="10">

                <Label Text="SOBRE O APLICATIVO"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>

                <Label Text="Sistema de reserva de hospedagem"
                       FontSize="14"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1" 
                         Color="#FFCCCC"/>

                <Label Text="Versao: 1.0"
                       FontSize="12"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>

                <Label Text="Ano: 2025"
                       FontSize="12"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>

                <Label Text="Plataforma: .NET MAUI"
                       FontSize="12"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </Frame>

        <Frame BackgroundColor="#000000"
               CornerRadius="15"
               Padding="15">
            <VerticalStackLayout Spacing="5">
                <Label Text="Desenvolvido por:"
                       FontSize="12"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>

                <Label Text="Vitor Hugo Miranda"
                       FontSize="14"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="#FF6B6B"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnVoltar"/>

    </VerticalStackLayout>

</ContentPage>